{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UE: 编译编辑器 (Win64 Development)",
      "type": "shell",
      "command": "D:/UE/UE_5.7/Engine/Build/BatchFiles/Build.bat",
      "args": [
        "AlongWithYourselfEditor",
        "Win64",
        "Development",
        "-Project=${workspaceFolder}/AlongWithYourself.uproject",
        "-WaitMutex",
        "-FromMsBuild",
        "-NoUBA"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "UE: 打开编辑器",
      "type": "shell",
      "command": "D:/UE/UE_5.7/Engine/Binaries/Win64/UnrealEditor.exe",
      "args": [
        "${workspaceFolder}/AlongWithYourself.uproject",
        "-log"
      ],
      "problemMatcher": []
    },
    {
      "label": "UE: 运行游戏窗口 (Lvl_Room)",
      "type": "shell",
      "command": "D:/UE/UE_5.7/Engine/Binaries/Win64/UnrealEditor.exe",
      "args": [
        "${workspaceFolder}/AlongWithYourself.uproject",
        "/Game/Room/Lvl_Room",
        "-game",
        "-windowed",
        "-resx=1280",
        "-resy=720",
        "-log"
      ],
      "problemMatcher": []
    }
  ]
}
